<?xml version="1.0"?>
<launch version="0.1.0">

  <!-- ====== args ====== -->
  <arg name="use_sim_time" default="false"/>

  
  <!-- 사람 있는 버전, 없는 버전 선택하는 과정임! 중요!! -->
  <!-- 사람 없음 -->
  <!--  
  <arg name="params_file" default="/home/hello-robot/ament_ws/src/stretch_ros2/stretch_nav2/config/nav2_params.yaml"/>
  -->
  <!-- 사람 있음 -->
  <arg name="params_file" default="/home/hello-robot/ament_ws/src/stretch_ros2/stretch_nav2/config/nav2_params_human.yaml"/>

  <arg name="map" default="/home/hello-robot/GitHub/visually-impaired-navigation-robot/src/blind_nav_system/maps/all.yaml"/>

  <!-- Nav2(네비게이션 파트) 시작을 localization보다 살짝 늦춰서 TF/맵 준비 레이스를 줄임 -->
  <arg name="nav_start_delay" default="5.0"/>
  <arg name="nav_autostart" default="true"/>

  <!-- ====== 1) Robot driver ====== -->
  <include file="$(find-pkg-share stretch_core)/launch/stretch_driver.launch.py">
    <arg name="mode" value="navigation"/>
    <arg name="broadcast_odom_tf" value="True"/>
  </include>

  <!-- ====== 2) LiDAR (rplidar_ros) ====== -->
  <node pkg="rplidar_ros" exec="rplidar_composition" name="rplidar" output="screen">
    <param name="serial_port" value="/dev/hello-lrf"/>
    <param name="serial_baudrate" value="115200"/>
    <param name="frame_id" value="laser"/>
  </node>

  <!-- ====== 2-2) RealSense D435i 카메라 드라이버 ====== -->
  <!--
    [목적] Local costmap에서 LiDAR가 못 잡는 중간 높이 장애물 (책상 상판, 선반, 사람 몸통 등) 감지
    [토픽] 이 노드가 올라오면 아래 토픽이 생성됨:
      - /camera/depth/color/points  (PointCloud2, nav2_params_human.yaml에 설정된 토픽)
    [확인] ros2 topic list | grep camera
  -->
  <node pkg="realsense2_camera" exec="realsense2_camera_node" name="camera" output="screen">
    <!-- [필수] 이 노드는 몸체 D435if만 잡도록 시리얼 번호로 고정.
         (device_type만으로는 못 믿음 — 실측: rs-enumerate-devices -s) -->
    <param name="serial_no" value="'250222073610'"/>
    <param name="device_type" value="d435"/>
    <!-- PointCloud2 활성화 (nav2 obstacle layer가 이 토픽을 구독) -->
    <param name="pointcloud.enable" value="true"/>
    <!-- [성능 최적화] 해상도 낮춰서 포인트클라우드 Hz 향상 -->
    <!-- 424x240x15: 장애물 감지 용도로 충분, CPU 부하 대폭 감소 -->
    <param name="depth_module.profile" value="424x240x15"/>
    <!-- color: 낮은 해상도로 활성화 (vision_assistant.py 에서 이미지 분석용) -->
    <param name="align_depth.enable" value="true"/>
    <param name="enable_color" value="true"/>
    <param name="rgb_camera.profile" value="424x240x15"/>
    <!-- QoS를 SENSOR_DATA로: 데이터 손실보다 속도 우선 -->
    <param name="pointcloud.pointcloud_qos" value="SENSOR_DATA"/>
  </node>

  <!-- ====== 2-3) RealSense D405 그리퍼 카메라 (엘리베이터 버튼 인식용) ====== -->
  <!--
    [중요] include(d405_basic.launch.py) 방식은 인자가 노드까지 전달되지 않아
    그리퍼 노드가 body 카메라(D435if)를 잡아버리는 사고가 있었음 (실측 확인).
    → body와 동일한 직접 <node> 방식 + 시리얼 번호 고정으로 변경.
    [프로파일] Hello Robot multi_camera.launch.py 검증값 (depth 480x270 / color 424x240)
    [확인] ros2 param get /gripper_camera serial_no → 130322271074 여야 정상
  -->
  <node pkg="realsense2_camera" exec="realsense2_camera_node" name="gripper_camera" output="screen">
    <param name="serial_no" value="'130322271074'"/>
    <param name="device_type" value="d405"/>
    <param name="initial_reset" value="true"/>
    <param name="enable_color" value="true"/>
    <param name="enable_depth" value="true"/>
    <param name="align_depth.enable" value="true"/>
    <!-- [주의] 이 드라이버 버전의 depth 프로파일 파라미터 이름은
         depth_module.depth_profile (구명칭 depth_module.profile은 무시됨 — 실측).
         이름이 틀리면 depth가 기본값(고해상도)으로 시작하려다 USB2 대역폭 초과로
         Frames Timeout 사망. D405는 이 로봇에서 USB2(2.1)로 연결돼 있음. -->
    <param name="depth_module.depth_profile" value="480x270x6"/>
    <param name="depth_module.profile" value="480x270x6"/>
    <!-- color 1280x720x6: ROI 집중 추적이 원본에서 잘라 쓰므로 고해상도가 실제 이득이 됨
         (타겟 숫자의 진짜 픽셀 2배). USB2 대역폭 때문에 fps는 6으로 낮춤 —
         화면은 약간 끊겨 보여도 OCR(~1Hz)과 서보에는 영향 없음.
         [만약 재시작 후 color가 Frames Timeout으로 죽으면 이 3줄을 640x480x15로 되돌릴 것] -->
    <param name="depth_module.color_profile" value="1280x720x6"/>
    <param name="rgb_camera.profile" value="1280x720x6"/>
    <param name="rgb_camera.color_profile" value="1280x720x6"/>
    <!-- 안 쓰는 스트림 꺼서 USB/CPU 부하 절감 -->
    <param name="pointcloud.enable" value="false"/>
    <param name="enable_gyro" value="false"/>
    <param name="enable_accel" value="false"/>
  </node>

  <!-- ====== 3) safety zone static TF ====== -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="safety_zone_left_back_tf" output="screen"
        args="--x -0.72 --y 0.72 --z 0.1 --yaw 0 --pitch 0 --roll 0 --frame-id base_link --child-frame-id safety_zone_left_back" />

  <!-- ====== cmd_vel remap (teleop / nav2 모두 stretch cmd_vel로) ====== -->
  <set_remap from="cmd_vel" to="/stretch/cmd_vel"/>
  <set_remap from="/cmd_vel" to="/stretch/cmd_vel"/>

  <!-- ====== 4) Localization: map_server + amcl ====== -->
  <node pkg="nav2_map_server" exec="map_server" name="map_server" output="screen">
    <param from="$(var params_file)"/>
    <param name="yaml_filename" value="$(var map)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="/tf" to="tf"/>
    <remap from="/tf_static" to="tf_static"/>
  </node>

  <node pkg="nav2_amcl" exec="amcl" name="amcl" output="screen">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="/tf" to="tf"/>
    <remap from="/tf_static" to="tf_static"/>
  </node>

  <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager"
        name="lifecycle_manager_localization" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="autostart" value="true"/>
    <param name="bond_timeout" value="10.0"/>
    <param name="node_names" value="['map_server', 'amcl']"/>
  </node>

  <!-- ====== 5) Navigation ====== -->
  <timer period="$(var nav_start_delay)">
    <include file="$(find-pkg-share stretch_nav2)/launch/navigation_launch.py">
      <arg name="namespace" value=""/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="autostart" value="$(var nav_autostart)"/>
      <arg name="params_file" value="$(var params_file)"/>
    </include>
  </timer>

  <!-- ====== 6) Global costmap 주기적 초기화 (동적 장애물 stale 마킹 제거) ====== -->
  <!-- Nav2 완전 기동 후 시작: nav_start_delay(5s) + Nav2 초기화(~15s) = 40s 대기 -->
  <executable
    cmd="bash -c 'sleep 40 &amp;&amp; while true; do sleep 5; ros2 service call /global_costmap/clear_entirely_global_costmap nav2_msgs/srv/ClearEntireCostmap &quot;{}&quot;; done'"
    name="global_costmap_cleaner"
    output="screen"/>

</launch>